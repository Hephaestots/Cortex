<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>324c1794-cfcc-4d7f-916a-3f5e3821d60b</UserSecretsId>
        <AspireUseCliBundle>true</AspireUseCliBundle>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
      <PackageReference Include="Aspire.Hosting.Keycloak" Version="17.0.0-preview.1.26567.5" />
      <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    </ItemGroup>

    <!--
      No ProjectReference to the services: AddDotnetProject takes a path (relative to this
      folder) and builds the project itself, so there is no generated Projects.* type to feed.
    -->

</Project>
